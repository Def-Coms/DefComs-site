---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import BlogArticle from '../components/BlogArticle.astro';
import CityPage from '../components/CityPage.astro';
import { cityMeta } from '../lib/city';
import CardList from '../components/CardList.astro';
import BlogListing from '../components/BlogListing.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data.city ? { ...cityMeta(entry.data.city, entry.id), ...entry.data, title: entry.data.title || cityMeta(entry.data.city, entry.id).title, description: entry.data.description || cityMeta(entry.data.city, entry.id).description } : entry.data;
const path = entry.id === 'index' ? '/' : '/' + entry.id;
const html = entry.rendered?.html ?? '';
const parts = html.split(/<!--@listing:([\w:-]+)-->/);
// parts alternates: html, marker, html, marker, ...
const [before, after] = html.split('<!--@listing-->');
---
<Page page={data} path={path}>
  {entry.data.city ? <CityPage city={entry.data.city} id={entry.id} /> : parts.length > 1 ? parts.map((part, i) => i % 2 === 0
    ? <Fragment set:html={part} />
    : <CardList list={part.split(':')[0]} group={part.split(':')[1]} />
  ) : entry.data.article ? (
    <BlogArticle page={entry.data} title={entry.data.title.replace(/\s*\|\s*DefComs$/, '')}>
      <Fragment set:html={before} />
    </BlogArticle>
  ) : <Fragment set:html={before} />}
  {entry.data.listing === 'blog' && <BlogListing />}
  {after !== undefined && <Fragment set:html={after} />}
</Page>
