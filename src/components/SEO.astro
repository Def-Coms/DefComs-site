---
import { site } from '../data/site';

const { page, path } = Astro.props;
const url = page.canonical ?? site.url + (path === '/' ? '/' : path);
const ogTitle = page.ogTitle ?? page.title;
const ogDescription = page.ogDescription ?? page.description;
const image = page.image ?? (page.article ? site.url + page.article.image : site.defaultImage);
const robots = page.robots ?? 'index, follow, max-snippet:-1, max-image-preview:large';
const a = page.article;
const org = { '@id': site.url + '/#organization' };
const generated = a
  ? [{
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'BlogPosting', '@id': url + '#article', headline: page.title.replace(/\s*\|\s*DefComs$/, ''), description: page.description,
          image: image, inLanguage: 'bg', mainEntityOfPage: url, author: { '@type': 'Person', name: a.author.name, url: site.url + a.author.href },
          datePublished: a.published.toISOString().slice(0, 10), dateModified: (a.updated ?? a.published).toISOString().slice(0, 10), publisher: org },
        { '@type': 'BreadcrumbList', '@id': url + '#breadcrumb', itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Начало', item: site.url + '/' },
          { '@type': 'ListItem', position: 2, name: 'Блог', item: site.url + '/blog' },
          { '@type': 'ListItem', position: 3, name: page.title.replace(/\s*\|\s*DefComs$/, ''), item: url } ] },
      ],
    }]
  : [];
const schema: object[] = page.schema ?? generated;
---
<title>{page.title}</title>
<meta name="description" content={page.description} />
<meta name="robots" content={robots} />
{Object.entries(page.meta ?? {}).map(([name, content]) => <meta name={name} content={content as string} />)}
<link rel="canonical" href={url} />
<link rel="alternate" hreflang={site.lang} href={url} />
<link rel="alternate" hreflang="x-default" href={url} />
<link rel="sitemap" type="application/xml" title="Sitemap" href={site.url + '/sitemap.xml'} />
<link rel="alternate" type="text/plain" href={site.url + '/llms.txt'} title="LLMs.txt" />
<meta property="og:type" content={page.ogType ?? (a ? 'article' : 'website')} />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={url} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={image} />
{page.imageAlt && <meta property="og:image:alt" content={page.imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={page.twitterTitle ?? ogTitle} />
<meta name="twitter:description" content={page.twitterDescription ?? ogDescription} />
<meta name="twitter:image" content={image} />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
