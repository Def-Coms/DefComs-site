---
import { getCollection } from 'astro:content';
import { formatBg as fmt, isoDate as iso } from '../lib/dates';
import { blogCard } from '../lib/blog';

const posts = (await getCollection('pages', ({ id, data }) => !data.draft && !!blogCard(data)))
  .sort((a, b) => +blogCard(b.data).date - +blogCard(a.data).date || blogCard(a.data).order - blogCard(b.data).order);
---
{posts.map(({ id, data }) => {
  const b = blogCard(data);
  const href = '/' + id;
  return (
    <article class="blog-listing-card">
      <a href={href} aria-label={b.ariaLabel}><img src={b.image} alt={b.imageAlt} width={b.imageWidth} height={b.imageHeight} loading="lazy" /></a>
      <div class="blog-listing-content">
        <span class="blog-listing-meta"><Fragment set:html={b.categories.join(' · ')} /> · <time datetime={iso(b.date)}>{fmt(b.date)}</time></span>
        <h2><a href={href} set:html={b.title} /></h2>
        <p set:html={b.summary} />
        <a href={href}>{b.cta}</a>
      </div>
    </article>
  );
})}
