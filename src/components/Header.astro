---
import { site, nav, navCta } from '../data/site';

const { current } = Astro.props;
const isCurrent = (href: string) =>
  href === '/' ? false : current === href || current.startsWith(href + '/');
---
<div class="mobile-nav-overlay"></div>
<header class="header">
  <nav class="nav" aria-label="Основна навигация">
    <div class="nav-container">
      <a href="/" class="logo">
        <img src={site.logo} alt={site.name} height="48" width="auto" />
      </a>
      <ul class="nav-menu">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="mobile-only"><a href={navCta.href} class="mobile-cta">{navCta.label}</a></li>
      </ul>
      <a href={navCta.href} class="cta-button">{navCta.label}</a>
      <button class="hamburger" type="button" aria-label="Отвори меню" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>
