---
const { service: s } = Astro.props;
---
<main><section class="service-landing-hero"><div class="container service-landing-grid"><div>{s.breadcrumb !== false && <nav class="blog-breadcrumbs" aria-label="Навигационна пътека" style="font-size: .9rem; margin-bottom: 16px;"><a href="/">Начало</a> › <a href="/services">Услуги</a> › <span set:html={s.short ?? s.name} /></nav>}<p class="service-landing-kicker" set:html={s.category} /><h1 set:html={s.name} /><p class="service-landing-lead" set:html={s.lead} /><div class="service-landing-actions"><a href={s.actions[0].href} class="btn btn-primary" set:html={s.actions[0].text} /><a href={s.actions[1].href} class="btn btn-secondary" set:html={s.actions[1].text} /></div></div><div class="service-landing-visual"><img src={s.image.src} alt={s.image.alt} width={s.image.width} height={s.image.height} fetchpriority={s.image.width ? 'high' : undefined} /><div class="service-landing-nodes">{s.nodes.map((n) => <div class="service-landing-node"><strong set:html={n.title} /><Fragment set:html={n.text} /></div>)}</div></div></div></section>{s.sections.map((b) => b.type === 'html' ? <Fragment set:html={b.html} /> : b.type === 'faq' ? (
<section class={b.alt ? 'service-landing-section alt' : 'service-landing-section'}><div class="container service-landing-faq"><p class="service-landing-kicker" set:html={b.kicker} /><h2 set:html={b.title} />{b.items.map((i) => <details open={i.open}><summary set:html={i.q} /><p set:html={i.a} /></details>)}</div></section>
) : (
<section class={b.alt ? 'service-landing-section alt' : 'service-landing-section'}><div class="container"><p class="service-landing-kicker" set:html={b.kicker} /><h2 set:html={b.title} /><Fragment set:html={b.body} /></div></section>
))}</main>
